# CrowdSense Root Environment Configuration Example

# Backend API Gateway
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-this-with-a-unique-random-secret-at-least-32-characters
ADMIN_REGISTRATION_CODE=replace-this-with-a-unique-admin-invitation-secret
JWT_EXPIRES_IN=24h
AI_SERVICE_URL=http://127.0.0.1:8000
CORS_ORIGIN=http://localhost:3000
MONGO_ROOT_USERNAME=crowdsense_root
MONGO_ROOT_PASSWORD=replace-with-unique-uri-safe-random-secret

# AI Microservice
DEFAULT_MODEL=csrnet
DEVICE=cpu
CSRNET_WEIGHTS_PATH=./weights/csrnet_shanghaitech.pth
