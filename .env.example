# CrowdSense Root Environment Configuration Example

# Backend API Gateway
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/crowdsense
JWT_SECRET=your-secure-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=24h
AI_SERVICE_URL=http://127.0.0.1:8000
CORS_ORIGIN=*

# AI Microservice
DEFAULT_MODEL=csrnet
DEVICE=cpu
CSRNET_WEIGHTS_PATH=./weights/csrnet_shanghaitech.pth
MCNN_WEIGHTS_PATH=./weights/mcnn_shanghaitech.pth
ONNX_WEIGHTS_PATH=./weights/csrnet.onnx
