# ============================================================
# CrowdSense Monorepo .gitignore
# ============================================================

# ──────────────────────────────────────────────────────────
# Environment & Secrets
# ──────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example
*.local

# ──────────────────────────────────────────────────────────
# Node.js / npm / frontend & backend
# ──────────────────────────────────────────────────────────
node_modules/
dist/
build/
.cache/
.parcel-cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Vite
frontend/.vite/
frontend/dist/

# ──────────────────────────────────────────────────────────
# Python / ai-service
# ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# Virtual environments
venv/
.venv/
env/
ENV/
.env/

# Pytest
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# ──────────────────────────────────────────────────────────
# ML / Model Weights & Large Files
# ──────────────────────────────────────────────────────────
# Model weight files (use Git LFS if you need to track these)
ml/weights/
*.pt
*.pth
*.ckpt
*.h5
*.hdf5
*.pb
*.onnx
*.tflite
*.bin
*.safetensors

# Datasets
ml/data/
datasets/
*.csv
*.parquet
*.arrow

# Jupyter Notebooks outputs
ml/notebooks/.ipynb_checkpoints/
.ipynb_checkpoints/

# ──────────────────────────────────────────────────────────
# Docker
# ──────────────────────────────────────────────────────────
.docker/
docker-compose.override.yml

# ──────────────────────────────────────────────────────────
# OS & Editor
# ──────────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr

# ──────────────────────────────────────────────────────────
# Misc
# ──────────────────────────────────────────────────────────
*.tmp
*.temp
*.swp
*.swo
*.bak
logs/
*.log
