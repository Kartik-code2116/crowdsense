# ============================================================
# CrowdSense .gitattributes
# ============================================================

# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.js      text eol=lf
*.jsx     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.py      text eol=lf
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.txt     text eol=lf
*.env     text eol=lf
*.example text eol=lf

# Declare Windows scripts with CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Treat these as binary (no line-ending conversion)
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.svg     binary
*.ico     binary
*.webp    binary
*.mp4     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary

# ML large binary files (use Git LFS)
*.pt      filter=lfs diff=lfs merge=lfs -text
*.pth     filter=lfs diff=lfs merge=lfs -text
*.ckpt    filter=lfs diff=lfs merge=lfs -text
*.h5      filter=lfs diff=lfs merge=lfs -text
*.hdf5    filter=lfs diff=lfs merge=lfs -text
*.onnx    filter=lfs diff=lfs merge=lfs -text
*.bin     filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text

# Zip/archives as binary
*.zip     binary
*.tar     binary
*.gz      binary
*.7z      binary
